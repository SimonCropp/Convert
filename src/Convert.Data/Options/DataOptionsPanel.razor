@namespace Convert
@inherits OptionsPanel<DataOptions>

@if (Options.ShowInference)
{
    <FlagOption Label="Detect numbers, true and false" Hint="Off keeps every value as text." @bind-Value="Options.InferTypes" @bind-Value:after="NotifyAsync" />
}
@if (Options.ShowPrettyPrint)
{
    <LayoutOption Label="Layout" @bind-Value="Options.PrettyPrint" @bind-Value:after="NotifyAsync" />
}
