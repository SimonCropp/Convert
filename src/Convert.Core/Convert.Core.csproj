<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Everything here is loaded at startup, so it references nothing heavy: the Components framework (Web
    for the components, WebAssembly for LazyAssemblyLoader, both part of the app's boot payload anyway),
    the icon runtime and ProjectDefaults. A pack's heavy libraries never appear in this project.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="IconifyBundle.Blazor" />
    <PackageReference Include="IconifyBundle.Lucide" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Convert.Tests" />
  </ItemGroup>

  <!--
    BuildInfo.Version (0.1.0+b4bbab2) for the footer and bug reports. A constant, since the trimmed
    browser build drops AssemblyInformationalVersionAttribute and reports the assembly as 0.0.0.0.
  -->
  <Target Name="WriteBuildInfo"
          BeforeTargets="CoreCompile"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ConvertShortSha>$(SourceRevisionId)</_ConvertShortSha>
      <_ConvertShortSha Condition="$(SourceRevisionId.Length) &gt; 7">$(SourceRevisionId.Substring(0, 7))</_ConvertShortSha>
      <_ConvertVersionText>$(Version)</_ConvertVersionText>
      <_ConvertVersionText Condition="'$(_ConvertShortSha)' != ''">$(_ConvertVersionText)+$(_ConvertShortSha)</_ConvertVersionText>
      <_ConvertBuildInfo>$(IntermediateOutputPath)BuildInfo.g.cs</_ConvertBuildInfo>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ConvertBuildInfo)"
                      Lines="namespace Convert%3B;static class BuildInfo { public const string Version = &quot;$(_ConvertVersionText)&quot;%3B }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_ConvertBuildInfo)" />
      <FileWrites Include="$(_ConvertBuildInfo)" />
    </ItemGroup>
  </Target>

</Project>
