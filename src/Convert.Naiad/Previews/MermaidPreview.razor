@namespace Convert
@inherits PreviewBase

@if (error is not null)
{
    <ErrorPanel Exception="error" Action="Preview Mermaid" />
}
@if (svg is not null)
{
    @* While the text does not parse (mid-edit, say) the last good diagram stays, dimmed, under the error. *@
    <div class="@(error is null ? "" : "stale-preview")">
        <SvgPreview Document="svg" />
    </div>
}
