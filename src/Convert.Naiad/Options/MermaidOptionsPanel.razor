@namespace Convert.Naiad
@inherits OptionsPanel<MermaidOptions>

@if (Options.Png)
{
    <NumberOption TValue="double" Label="Scale" Hint="2 renders at twice the diagram's size." Min="0.25" Max="8" Step="0.25" @bind-Value="Options.PngScale" @bind-Value:after="NotifyAsync" />
    <TextOption Label="Background" Color="true" @bind-Value="Options.PngBackground" @bind-Value:after="NotifyAsync" />
}
<AdvancedOptions>
    <NumberOption TValue="int" Label="Font size" Min="6" Max="48" Step="1" @bind-Value="Options.FontSize" @bind-Value:after="NotifyAsync" />
    <TextOption Label="Font family" @bind-Value="Options.FontFamily" @bind-Value:after="NotifyAsync" />
    <NumberOption TValue="double" Label="Padding" Min="0" Max="200" Step="1" @bind-Value="Options.Padding" @bind-Value:after="NotifyAsync" />
    @if (!Options.Png)
    {
        <FlagOption Label="HTML labels" Hint="Richer labels; the SVG then imports Font Awesome from a CDN." @bind-Value="Options.AllowHtmlElements" @bind-Value:after="NotifyAsync" />
    }
</AdvancedOptions>
