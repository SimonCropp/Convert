<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Trimmed, default (partial) mode: the BCL and the Components framework shrink, every other assembly
      is kept as published unless it opts in. The reflection-heavy libraries are rooted below and by
      Morph.Blazor's buildTransitive targets (OpenXml, AngleSharp, the SixLabors set).
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      No ICU is shipped, so a named culture (OfficeIMO's text casing asks for en-US) would throw
      CultureNotFoundException; off, it is created over invariant data instead.
    -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!--
      Single-threaded runtime (WasmEnableThreads off): the threaded one needs a cross-origin-isolated page
      (COOP/COEP), which GitHub Pages cannot serve. Conversions run on the UI thread and yield with
      `await Task.Run` so the progress state paints first.
    -->
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!--
      REQUIRED for PDF export through Morph: Krilla (Morph.Pdf) ships its browser-wasm native as a static
      archive (runtimes/browser-wasm/native/krilla_capi.a, 10.9 MB) that only a native build links into
      dotnet.native.wasm. Without it the app runs and fails on the first PDF with "krilla_capi could not
      be loaded". It is linked whether or not Krilla.wasm (lazy) ever loads: ~0.7 MB brotli of fixed cost
      on every first visit. Needs `dotnet workload install wasm-tools`.
    -->
    <WasmBuildNative>true</WasmBuildNative>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- The host `dotnet run` launches; development only. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- The icon generator compiles in only the icons a project names, so the app references the pack too. -->
    <PackageReference Include="IconifyBundle.Blazor" />
    <PackageReference Include="IconifyBundle.Lucide" />
    <ProjectReference Include="..\Convert.Core\Convert.Core.csproj" />
    <ProjectReference Include="..\Convert.Browser\Convert.Browser.csproj" />
    <ProjectReference Include="..\Convert.Data\Convert.Data.csproj" />
    <ProjectReference Include="..\Convert.Geo\Convert.Geo.csproj" />
    <ProjectReference Include="..\Convert.ImageSharp\Convert.ImageSharp.csproj" />
    <ProjectReference Include="..\Convert.Markdig\Convert.Markdig.csproj" />
    <ProjectReference Include="..\Convert.Morph\Convert.Morph.csproj" />
    <ProjectReference Include="..\Convert.Naiad\Convert.Naiad.csproj" />
    <ProjectReference Include="..\Convert.OfficeIMO\Convert.OfficeIMO.csproj" />
    <ProjectReference Include="..\Convert.OpenXmlHtml\Convert.OpenXmlHtml.csproj" />
    <ProjectReference Include="..\Convert.Skia\Convert.Skia.csproj" />
  </ItemGroup>

  <!--
    Rooted whole. Every Convert.* pack is tiny glue whose components are reached only through
    DynamicComponent (a Type), which the trimmer cannot follow. OpenXmlHtml and OpenXmlKit are not
    verified trim-safe. Morph.Blazor's buildTransitive targets root OpenXml, AngleSharp and the SixLabors
    set, which also covers OfficeIMO, OpenXmlHtml and Naiad.ImageSharp. Rooting is an ILLink input and
    lazy loading a manifest input, so an assembly can be both.
  -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="OpenXmlHtml" />
    <TrimmerRootAssembly Include="OpenXmlKit" />
    <TrimmerRootAssembly Include="Convert.Core" />
    <TrimmerRootAssembly Include="Convert.Browser" />
    <TrimmerRootAssembly Include="Convert.Data" />
    <TrimmerRootAssembly Include="Convert.Geo" />
    <TrimmerRootAssembly Include="Convert.ImageSharp" />
    <TrimmerRootAssembly Include="Convert.Markdig" />
    <TrimmerRootAssembly Include="Convert.Morph" />
    <TrimmerRootAssembly Include="Convert.Naiad" />
    <TrimmerRootAssembly Include="Convert.OfficeIMO" />
    <TrimmerRootAssembly Include="Convert.OpenXmlHtml" />
    <TrimmerRootAssembly Include="Convert.Skia" />
    <!-- Svg.Skia's SVG DOM (Svg.Custom) maps elements and attributes by reflection, and ExCSS likewise. -->
    <TrimmerRootAssembly Include="Svg.Custom" />
    <TrimmerRootAssembly Include="Svg.Model" />
    <TrimmerRootAssembly Include="Svg.Skia" />
    <TrimmerRootAssembly Include="ExCSS" />
    <!-- Tomlyn and YamlDotNet: only their model and emitter are used, but neither is verified trim-safe here. -->
    <TrimmerRootAssembly Include="Tomlyn" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>

  <!--
    Downloaded on first use, not at boot: the union of every pack entry's Assemblies list (LazyLoadTests
    keeps the two in sync, both directions). A lazy assembly's dependency that is missing here would land
    in the boot manifest instead, so each entry declares its whole closure.
  -->
  <ItemGroup>
    <!-- Shared by several packs. -->
    <BlazorWebAssemblyLazyLoad Include="AngleSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="AngleSharp.Css.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DocumentFormat.OpenXml.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DocumentFormat.OpenXml.Framework.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.IO.Packaging.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.IO.Hashing.wasm" />
    <BlazorWebAssemblyLazyLoad Include="SixLabors.ImageSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="SixLabors.ImageSharp.Drawing.wasm" />
    <BlazorWebAssemblyLazyLoad Include="SixLabors.Fonts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="SixLabors.PolygonClipper.wasm" />
    <!-- Markdig. -->
    <BlazorWebAssemblyLazyLoad Include="Markdig.wasm" />
    <!-- Naiad. -->
    <BlazorWebAssemblyLazyLoad Include="Naiad.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Naiad.ImageSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Parlot.wasm" />
    <!-- GeoConvert. -->
    <BlazorWebAssemblyLazyLoad Include="GeoConvert.wasm" />
    <!-- OpenXmlHtml. -->
    <BlazorWebAssemblyLazyLoad Include="OpenXmlHtml.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OpenXmlKit.wasm" />
    <!-- Morph. -->
    <BlazorWebAssemblyLazyLoad Include="Morph.Blazor.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Morph.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Morph.ImageSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Morph.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Krilla.wasm" />
    <!-- Skia: SkiaSharp for raster routes; SVG routes add Svg.Skia and its closure. -->
    <BlazorWebAssemblyLazyLoad Include="SkiaSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Svg.Skia.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Svg.Model.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Svg.Custom.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Svg.SceneGraph.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Svg.Animation.wasm" />
    <BlazorWebAssemblyLazyLoad Include="ShimSkiaSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="ExCSS.wasm" />
    <BlazorWebAssemblyLazyLoad Include="HarfBuzzSharp.wasm" />
    <!-- Data: YAML and TOML (JSON, XML, CSV and TSV are the runtime's own). -->
    <BlazorWebAssemblyLazyLoad Include="YamlDotNet.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Tomlyn.wasm" />
    <!-- OfficeIMO: each route names its own subset. -->
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Core.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Word.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Excel.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.PowerPoint.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Publisher.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Markdown.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Html.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Html.Core.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Html.AngleSharp.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.MarkdownRenderer.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Markdown.Html.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Word.Markdown.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Word.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Excel.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.PowerPoint.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Publisher.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Html.Pdf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Pdf.Word.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Pdf.Excel.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OfficeIMO.Pdf.PowerPoint.wasm" />
  </ItemGroup>

  <!--
    SkiaSharp 4.155.0 ships libSkiaSharp.a for emscripten 3.1.34, 3.1.56 and 5.0.6, but its targets link
    3.1.56 for every TFM from net9.0. That archive uses emscripten 3's setjmp ABI (saveSetjmp/testSetjmp),
    which the .NET 11 SDK's emscripten 6.0.2 no longer has, so the link fails. Swap in the 5.0.6 archive,
    the one HarfBuzzSharp 14.4.0's own targets already pick for net11.0. Drop this once SkiaSharp selects
    it itself (4.156 does, with a 6.0.2 archive).
  -->
  <Target Name="UseSkiaSharpEmscripten5" BeforeTargets="PrepareForBuild" Condition="'$(SkiaSharpStaticLibraryPath)' != ''">
    <ItemGroup>
      <_SkiaSharpEmscripten3 Include="@(NativeFileReference)" Condition="$([System.String]::Copy('%(FullPath)').Replace('\', '/').Contains('libSkiaSharp.a/3.1.56/'))" />
      <NativeFileReference Remove="@(_SkiaSharpEmscripten3)" />
      <NativeFileReference Include="$(SkiaSharpStaticLibraryPath)/5.0.6/$(_SkiaSharpNativeBinaryType)/*.a" />
    </ItemGroup>
  </Target>

  <!--
    js/version.js: the version the loading screen shows before .NET runs (v0.1.0+b4bbab2), so a page the
    browser kept from an earlier deploy is plain to see. Written to obj and linked into wwwroot as a
    static web asset; rewriting index.html after publish would leave its .br/.gz stale.
  -->
  <Target Name="WriteVersionScript"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ConvertShortSha>$(SourceRevisionId)</_ConvertShortSha>
      <_ConvertShortSha Condition="$(SourceRevisionId.Length) &gt; 7">$(SourceRevisionId.Substring(0, 7))</_ConvertShortSha>
      <_ConvertVersionText>v$(Version)</_ConvertVersionText>
      <_ConvertVersionText Condition="'$(_ConvertShortSha)' != ''">$(_ConvertVersionText)+$(_ConvertShortSha)</_ConvertVersionText>
      <_ConvertVersionScript>$(IntermediateOutputPath)version.js</_ConvertVersionScript>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ConvertVersionScript)"
                      Lines="window.convertVersion = '$(_ConvertVersionText)'%3B"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(_ConvertVersionScript)" Link="wwwroot\js\version.js" />
      <FileWrites Include="$(_ConvertVersionScript)" />
    </ItemGroup>
  </Target>

  <!--
    obj/webcil holds each assembly converted to .wasm, redone only when the dll is newer than its .wasm.
    NuGet keeps a package's own file dates, so a package update can bring an older-dated dll and the
    previous version's .wasm ships instead (Naiad 2.1.0 ran against Parlot 1.5.11 that way). Restore
    rewrites project.assets.json only when packages change: when it is newer than the stamp, start over.
  -->
  <Target Name="ClearStaleWebcil"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(ProjectAssetsFile)')">
    <PropertyGroup>
      <_ConvertWebcilDirectory>$(IntermediateOutputPath)webcil\</_ConvertWebcilDirectory>
      <_ConvertWebcilStamp>$(IntermediateOutputPath)webcil.assets.stamp</_ConvertWebcilStamp>
      <_ConvertWebcilStale>false</_ConvertWebcilStale>
      <_ConvertWebcilStale Condition="!Exists('$(_ConvertWebcilStamp)')">true</_ConvertWebcilStale>
      <_ConvertWebcilStale Condition="Exists('$(_ConvertWebcilStamp)') And $([System.IO.File]::GetLastWriteTimeUtc('$(ProjectAssetsFile)').Ticks) &gt; $([System.IO.File]::GetLastWriteTimeUtc('$(_ConvertWebcilStamp)').Ticks)">true</_ConvertWebcilStale>
    </PropertyGroup>
    <RemoveDir Directories="$(_ConvertWebcilDirectory)" Condition="$(_ConvertWebcilStale)" />
    <!-- A fresh checkout has no obj/{Configuration}/{TargetFramework} yet: PrepareForBuild makes it later. -->
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="$(_ConvertWebcilStale)" />
    <Touch Files="$(_ConvertWebcilStamp)" AlwaysCreate="true" Condition="$(_ConvertWebcilStale)" />
    <ItemGroup>
      <FileWrites Include="$(_ConvertWebcilStamp)" />
    </ItemGroup>
  </Target>

</Project>
