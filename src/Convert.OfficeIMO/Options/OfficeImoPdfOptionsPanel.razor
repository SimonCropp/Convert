@namespace Convert.OfficeIMO
@inherits OptionsPanel<OfficeImoPdfOptions>

<ChoiceOption TValue="PdfProfile" Label="PDF profile" Choices="OfficeImoChoices.Profiles" @bind-Value="Options.Profile" @bind-Value:after="NotifyAsync" />
@if (Options.Excel)
{
    <FlagOption Label="Quick preview" Hint="Up to 250 rows per sheet. Workbooks over 50,000 cells are always previewed this way." @bind-Value="Options.QuickPreview" @bind-Value:after="NotifyAsync" />
}
