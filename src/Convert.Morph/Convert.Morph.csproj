<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Morph.Blazor brings Morph, Morph.ImageSharp, Morph.Pdf (Krilla), AngleSharp, the SixLabors set and
       OpenXml, plus buildTransitive targets that root the reflection-heavy ones for a trimmed publish. -->
  <ItemGroup>
    <ProjectReference Include="..\Convert.Core\Convert.Core.csproj" />
    <PackageReference Include="Morph.Blazor" />
    <PackageReference Include="IconifyBundle.Blazor" />
    <PackageReference Include="IconifyBundle.Lucide" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

</Project>
