@using global::Morph

@* Morph's word processor (the viewer only shows a document; MorphViewer's ReadOnly governs comments, not
   text). Every edit hands back the document's bytes, which become the session's source. The editor's
   own file chrome is hidden: the wizard owns the file. *@
<div class="morph-preview">
    <MorphEditor Source="@source"
                 FileName="@Document.FileName"
                 ShowNew="false"
                 ShowOpenFile="false"
                 ShowDownload="false"
                 ShowPrint="false"
                 ShowIssueLink="false"
                 OnDocumentChanged="OnDocumentChanged" />
</div>
