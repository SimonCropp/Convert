<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Blazor, pinned to the .NET 10 runtime the web SDK ships. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="IconifyBundle.Blazor" Version="1.1.0" />
    <PackageVersion Include="IconifyBundle.Lucide" Version="1.1.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.187" />

    <!-- Tools wrapped by the packs. -->
    <PackageVersion Include="Markdig" Version="1.5.1" />
    <PackageVersion Include="OpenXmlHtml" Version="1.7.5" />
    <PackageVersion Include="Morph.Blazor" Version="1.23.12" />
    <PackageVersion Include="Naiad" Version="2.0.1" />
    <PackageVersion Include="Naiad.ImageSharp" Version="2.0.1" />
    <PackageVersion Include="GeoConvert" Version="2.1.0" />
    <PackageVersion Include="OfficeIMO.Word.Pdf" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Excel.Pdf" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.PowerPoint.Pdf" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Publisher.Pdf" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Html.Pdf" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.MarkdownRenderer" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Markdown.Html" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Word.Markdown" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Pdf.Word" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Pdf.Excel" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Pdf.PowerPoint" Version="3.6.0" />
    <PackageVersion Include="OfficeIMO.Pdf" Version="3.6.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!--
      Skia, stable. 4.155's targets would link its emscripten 3.1.56 archive, which the .NET 11 SDK's
      emscripten 6.0.2 cannot; Convert.Web swaps in the package's 5.0.6 archive (UseSkiaSharpEmscripten5).
      HarfBuzzSharp (Svg.Skia's text shaping) is the release paired with it, so the managed and native
      halves agree; its own targets already link 5.0.6 for net11.0.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.155.0" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <!-- Overlaps between packs, resolved to one version each. -->
    <PackageVersion Include="Krilla" Version="0.3.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="AngleSharp" Version="1.9.1" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="TUnit" Version="1.79.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="DiffEngine" Version="20.8.2" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
  </ItemGroup>
</Project>
